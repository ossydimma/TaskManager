@* @rendermode RenderMode.InteractiveAuto *@
@inherits LayoutComponentBase
@inject IJSRuntime JSRuntime

<div class="bg-[#dadde2] w-screen h-auto md:h-screen pr-0 md:pr-3 sm:pr-1 flex gap-0 sm:gap-1 md:gap-3">
    @if(IsAuthenticated)
    {
        <SideBar OnScrollToTop="ScrollToTop" />
    }
    <div class="relative bg-[#f6f5f5] h-[98Vh] @(!IsAuthenticated ?  "ml-2.5" : "") overflow-x-hidden overflow-y-scroll md:overflow-hidden my-0 sm:my-[1vh]  w-screen sm:rounded-[2rem] opacity-" @ref="ScrollableDiv" >
        @if(IsAuthenticated)
        {
            <Header />
        }
         @Body    
        <CreateTask />
    </div>
</div>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    private bool IsAuthenticated { get; set; } = false;
    private ElementReference ScrollableDiv;

    private async Task ScrollToTop()
    {
        await JSRuntime.InvokeVoidAsync("scrollToTop", ScrollableDiv);
    }
}