                <h1 class="font-bold font-serif text-3xl text-center "> @(Option is "Edit" ? "Edit Task" : Option is "Details" ? "Task Details" : "Delete Task" )</h1>
            </div>
            <div class="h-[85%] overflow-y-scroll overflow-x-hidden pb-6 ">
                @if (SelectedTask is null)
                {
                    <p class="text-center text-xl pt-[14rem]">loading...</p>
                }
                else
                {
                    @if (Option is "Details")
                    {
                        <dl class="flex flex-col gap-2 px-4 @(SelectedTask.Description.Length > 200 ? "mt-[1rem]" : "mt-[2rem]")">
                        
                            <div class="flex items-center  gap-[7rem] border p-3">
                                <dt class="font-bold text-lg">Task Name :</dt>
                                <dd class="font-medium">@SelectedTask.Title</dd>
                            </div>

                            <div class="flex gap-[7rem] border p-3">
                                <dt class="font-bold text-lg">Description:</dt>
                                <dd class="font-medium">@SelectedTask.Description</dd>
                            </div>

                            <div class="flex items-center  gap-[8.5rem] border p-3">
                                <dt class="font-bold text-lg">Deadline :</dt>
                                <dd class="font-medium">@SelectedTask.Deadline</dd>
                            </div>

                            <div class="flex items-center  gap-[8rem] border p-3  ">
                                <dt class="font-bold text-lg">Category :</dt>
                                <dd class="font-medium ">@SelectedTask.Category</dd>
                            </div>

                            <div class="flex items-center  gap-[9.5rem] border p-3">
                                <dt class="font-bold text-lg">Status :</dt>
                                <dd class="font-medium">@(SelectedTask.Status == true ? "Completed" : "Pending")</dd>
                            </div>

                        </dl>
                        <div class="mt-4 flex items-center justify-between mr-4 " >
                            <p class="underline text-red-500 cursor-pointer">Delete Task</p>
                            <p class="text-blue-400 underline cursor-pointer " @onclick="NavigateToEditTask" >Edit Task</p>
                        </div>
                    }
                    else if (Option is "Edit")
                    {
                        <div class="  mx-auto ">
                            <EditForm Model="editTasksDto" OnValidSubmit="SaveChanges" FormName="Edit" Enhance method="put" 
                                class="flex flex-col gap-4 mt-5 md:mt-6 w-[90%] "
                            >
                                <DataAnnotationsValidator />
                                <ValidationSummary role="alert" class="text-red-500" />
                                <divF class="flex flex-col">
                                    <label for="title" class="text-lg font-medium">Project Title</label>
                                    <InputText id="title" @bind-Value="editTasksDto.Title" placeholder="Enter Project Title"
                                        class="border border-gray-600 rounded-lg outline-none py-2 px-4  w-[100%]"/>
                                    <ValidationMessage class="text-red-500" For="() => editTasksDto.Title" />
                                </divF>

                                <div class="flex justify-between items-center">
                                    <div class="flex flex-col @(editTasksDto.Status == true ? "w-[100%]" : "w-[45%]") ">
                                        <label for="deadline" class="text-lg font-medium">Project Deadline</label>
                                        <InputDate id="deadline" @bind-Value="editTasksDto.Deadline" placeholder="DD/MM/YYYY"
                                            class="border border-gray-600 rounded-lg  outline-none py-2 px-4 w-full" />
                                        <ValidationMessage class="text-red-500" For="() => editTasksDto.Deadline" />
                                    </div>

                                    @if (SelectedTask.Status == false)
                                    {

                                        <div class="w-[45%] relative checkBox-conatiner">
                                            <label for="status" class="text-lg font-medium">Status</label>
                                            <div class=" checkBox-tooltip bg-blue-600 text-white border border-white px-4 py-2 rounded-lg absolute">
                                                <span>Check the box</span>
                                            </div>
                                            <div class="flex items-center justify-between border border-gray-600 rounded-lg py-2 px-4">
                                                Completed
                                                <InputCheckbox id="status" @bind-Value="editTasksDto.Status" class=" w-[10%] h-5 rounded-full" />
                                                <ValidationMessage class="text-red-500" For="() => editTasksDto.Status" />
                                            </div>
                                             
                                        </div>
                                       
                                        
                                    }
                                    
                                </div>
                                
                                <div>
                                    <InputTextArea id="description" @bind-Value="editTasksDto.Description"  placeholder="Enter a description"
                                    class="border border-gray-600 rounded-lg outline-none py-2 px-4 w-[100%] h-24" />
                                    <ValidationMessage class="text-red-500" For="() => editTasksDto.Description" />
                                </div>
                            

                                <div>
                                    <label for="category" class="text-lg font-medium">Category</label>
                                    <InputSelect id="category" @bind-Value="editTasksDto.Category" TValue="string" name="category" class="border border-gray-600 rounded-lg outline-none py-2 px-4  w-[100%]">
                                        <option value="Personal">Personal</option>
                                        <option value="Work">work</option>
                                        <option value="others">others</option>
                                    </InputSelect>
                                    <ValidationMessage class="text-red-500" For="() => editTasksDto.Category" />
                                </div>
                                <div class="bg-black  text-white w-[8rem] py-4 text-center rounded-2xl ml-auto ">
                                    <button type="submit" class="">Save Changes</button>
                                </div>

                            </EditForm>
                        </div> 

                    }
                        
                    
                }
            </div>


        </div>
    }
    
</main>

@code {

    private UserTasks? SelectedTask { get; set; } 
    private bool DisplayMoreOptions = false;
