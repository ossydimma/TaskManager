    private PaginationState pagination = new PaginationState{ ItemsPerPage = 4 };
    private EditTasksDto editTasksDto = new EditTasksDto();

    protected override void OnInitialized()
    {
        SharedData.OnChange += StateHasChanged;
    }

    private void HandleCreateTaskDisplay()
    {
        SharedData.ShowCreateTask = !SharedData.ShowCreateTask;

    }

    @* diplaying task details *@
    private void ViewDetails(Guid id)
    {
        UserTasks? task = tasks.FirstOrDefault(t => t.Id == id);
        if (task != null)
        {
            DisplayMoreOptions = true;
            SelectedTask = task;
            Option = "Details";
            Console.WriteLine(SelectedTask);
        }
        else
        {
            Console.WriteLine($"{id} Task not found");
        }
    }

    @* Editing task *@
    private void EditTask(Guid id)
    {
        UserTasks? task = tasks.FirstOrDefault(t => t.Id == id);
        if (task != null)
        {
            DisplayMoreOptions = true;
            SelectedTask = task;
            Option = "Edit";

            editTasksDto.Title = SelectedTask.Title;
            editTasksDto.Description = SelectedTask.Description;
            editTasksDto.Deadline = SelectedTask.Deadline;
            editTasksDto.Category = SelectedTask.Category;
            editTasksDto.Status = SelectedTask.Status;
            Console.WriteLine(task.Id);
        }
        else
        {
            Console.WriteLine($"{id} Task not found");
        }
    }

    private void SaveChanges()
    {
        if (SelectedTask != null)
        {
            SelectedTask.Title = editTasksDto.Title;
            SelectedTask.Description = editTasksDto.Description;
            SelectedTask.Deadline = editTasksDto.Deadline;
            SelectedTask.Category = editTasksDto.Category;
            SelectedTask.Status = editTasksDto.Status;

            DisplayMoreOptions = false;
            SelectedTask = null;
        }
    }

    private void NavigateToEditTask()
    {
        Option = "Edit";
    }

    public void Dispose()
