@page "/mytasks"
@inject SharedDataServices.SharedDataService SharedData
@implements IDisposable

<main>
    <div class="flex justify-between items-center px-4">
        @* <h1 class="font-bold font-serif text-2xl">My Tasks</h1> *@
        <section class=" flex gap-2 items-center text-sm">
            <div class="py-2 px-4 bg-black text-white rounded-xl cursor-pointer">All Tasks</div>
            <div class="py-2 px-4  text-black border border-gray-500 cursor-pointer rounded-xl">On Progress</div>
            <div class="py-2 px-4  text-black border border-gray-500 cursor-pointer rounded-xl">Completed</div>
        </section>
        
        <div class="flex items-center gap-3">
           
            <div
                class=" border text-sm border-gray-600 rounded-md py-2 px-4 flex items-center gap-2 cursor-pointer hover:bg-black hover:text-white stroke-black hover:stroke-white">
                <svg class="w-4" viewBox="-0.5 0 25 25" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                    <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                    <g id="SVGRepo_iconCarrier">
                        <path
                            d="M22 3.58002H2C1.99912 5.28492 2.43416 6.96173 3.26376 8.45117C4.09337 9.94062 5.29 11.1932 6.73999 12.09C7.44033 12.5379 8.01525 13.1565 8.41062 13.8877C8.80598 14.6189 9.00879 15.4388 9 16.27V21.54L15 20.54V16.25C14.9912 15.4188 15.194 14.599 15.5894 13.8677C15.9847 13.1365 16.5597 12.5178 17.26 12.07C18.7071 11.175 19.9019 9.92554 20.7314 8.43988C21.5608 6.95422 21.9975 5.28153 22 3.58002Z"
                            stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path>
                    </g>
                </svg>
                Filter
            </div>

            <div
                class=" border text-sm border-gray-600 rounded-md py-2 px-2.5 flex items-center gap-1 cursor-pointer bg-black hover:bg-white text-white hover:text-black stroke-white hover:stroke-black"
                @onclick="HandleCreateTaskDisplay"
                >
                <svg class="w-5" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                    <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                    <g id="SVGRepo_iconCarrier">
                        <path d="M6 12H18M12 6V18" stroke-width="2" stroke-linecap="round"
                            stroke-linejoin="round"></path>
                    </g>
                </svg>
                <p>New Task</p>
                
            </div>
        </div>
        
    </div>
    <section class="w-[98%] h-[50vh]  mx-2 mt-5">
        <div class="  grid grid-cols-7 text-center mb-0">
            @foreach (string table in new[] { "Category", "Task Name", "Description", "Deadline", "Status", ""})
            {
                <div class="font-bold py-1 @(table == "Description" ? "col-span-2" : "")">@table</div>
            }
        </div>
        
        <div class="  grid grid-cols-7 justify-between border border-b-2 -mt-1">
            @foreach (string item in new[] { "Personal", "Shopping", "Tue hede cjdndm jfjfkr ifdjfk jhdnd jhdd ", "10/11/2024", "Completed", ":" })
            {
                <div class="border border-gray-400 flex justify-center items-center py-5 @(item.Length > 12 ? "col-span-2" : "")">@item</div>
            }
        </div>
        <div class="  grid grid-cols-7 justify-between border border-b-2 -mt-1">
            @foreach (string item in new[] { "Personal", "Shopping", "Tue hede cjdndm jfjfkr ifdjfk jhdnd jhdd ", "10/11/2024", "Completed", ":" })
            {
                <div class="border border-gray-400 flex justify-center items-center py-5 @(item.Length > 12 ? "col-span-2" : "")">@item</div>
            }
        </div>
        <div class="  grid grid-cols-7 justify-between border border-b-2 -mt-1">
            @foreach (string item in new[] { "Personal", "Shopping", "Tue hede cjdndm jfjfkr ifdjfk jhdnd jhdd ", "10/11/2024", "Completed", ":" })
            {
                <div class="border border-gray-400 flex justify-center items-center py-5 @(item.Length > 12 ? "col-span-2" : "")">@item</div>
            }
        </div>
        <div class="  grid grid-cols-7 justify-between border border-b-2 -mt-1">
            @foreach (string item in new[] { "Personal", "Shopping", "Tue hede cjdndm jfjfkr ifdjfk jhdnd jhdd ", "10/11/2024", "Completed", ":" })
            {
                <div class="border border-gray-400 flex justify-center items-center py-5 @(item.Length > 12 ? "col-span-2" : "")">@item</div>
            }
        </div>
        <div class="  grid grid-cols-7 justify-between border border-b-2 -mt-1">
            @foreach (string item in new[] { "Personal", "Shopping", "Tue hede cjdndm jfjfkr ifdjfk jhdnd jhdd ", "10/11/2024", "Completed", ":" })
            {
                <div class="border border-gray-400 flex justify-center items-center py-5 @(item.Length > 12 ? "col-span-2" : "")">@item</div>
            }
        </div>
        <div class="  grid grid-cols-7 justify-between border border-b-2 -mt-1">
            @foreach (string item in new[] { "Personal", "Shopping", "Tue hede cjdndm jfjfkr ifdjfk jhdnd jhdd ", "10/11/2024", "Completed", ":" })
            {
                <div class="border border-gray-400 flex justify-center items-center py-5 @(item.Length > 12 ? "col-span-2" : "")">@item</div>
            }
        </div>
        <div class="  grid grid-cols-7 justify-between border border-b-2 -mt-1">
            @foreach (string item in new[] { "Personal", "Shopping", "Tue hede cjdndm jfjfkr ifdjfk jhdnd jhdd ", "10/11/2024", "Completed", ":" })
            {
                <div class="border border-gray-400 flex justify-center items-center py-5 @(item.Length > 12 ? "col-span-2" : "")">@item</div>
            }
        </div>
        
    </section>
</main>

@code {
    protected override void OnInitialized()
    {
        SharedData.OnChange += StateHasChanged;
    }

    private void HandleCreateTaskDisplay()
    {
        SharedData.ShowCreateTask = !SharedData.ShowCreateTask;

    }

    public void Dispose()
    {
        SharedData.OnChange -= StateHasChanged;
    }
}