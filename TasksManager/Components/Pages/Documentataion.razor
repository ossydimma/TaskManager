@page "/documentation"
@implements IDisposable
@inject SharedDataServices.SharedDataService SharedData

@* <h2>Documentation</h2> *@
<main class="flex justify-between items-center flex-col gap-4 md:gap-2 md:flex-row h-[85%] pt-5 border-gray-500 border-t-2 border-dotted">
    
    <section class="w-[94%] md:w-[60%] h-[80vh] sm:h-[95vh] md:h-full mx-3 md:mx-4 shadow-2xl rounded-2xl border py-2 md:py-6 px-2 md:px-6 relative">

        <div class="flex items-center justify-between">
            <input type="text" placeholder="Enter Title" readonly="@IsReadOnly" @bind="@ContentTitle"   class="w-[100%] outline-none border-b border-gray-700  py-2 px-4 bg-transparent font-serif font-bold ">
        </div>

        <div class=" h-[58%] md:h-[78%] ">
            <textarea name="Document" placeholder="Start Documenting..." readonly="@IsReadOnly" @bind="@ContentBody"  class="w-full h-full p-4 bg-transparent outline-none "></textarea>
        </div>

        @if (Feedback)
        {
            <div class=" bg-red-500  border w-[80%] h-fit py-10 flex flex-col gap-4 justify-center items-center rounded-2xl absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 ">
                <p class=" text-2xl text-white font-mono font-semibold">@FeedbackText</p>
                <button class="bg-white text-black hover:text-red-600 py-3 px-10 rounded-2xl font-bold hover:scale-90 transition-transform duration-300" @onclick="()=> Feedback = !Feedback ">Ok</button>
            </div>
        }
        

        <div class=" flex justify-end mt-4">
            @if(IsReadOnly)
            {
                <svg 
                    class="w-8 cursor-pointer " viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg"
                    @onclick="() => 
                    {
                        ContentTitle = null;
                        ContentBody = null;
                        IsReadOnly = false;

                        StateHasChanged();
                    }"
                    >
                    <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
                    <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
                    <g id="SVGRepo_iconCarrier">
                        <g id="cancel">
                            <g id="cancel_2">
                                <path id="Combined Shape" fill-rule="evenodd" clip-rule="evenodd"
                                    d="M36.3291 10.2931L29.0251 17.5971C28.9938 17.6284 28.961 17.6571 28.9269 17.6834C28.9002 17.7181 28.871 17.7515 28.8393 17.7833L25.4403 21.1822L26.8539 22.5958L37.7428 11.7069C38.1342 11.3156 38.1342 10.6834 37.7419 10.2922C37.3527 9.90193 36.7192 9.90193 36.3291 10.2931ZM28.2682 24.01L39.1571 13.1211C40.3297 11.9484 40.3297 10.0486 39.1562 8.87798C37.9872 7.70606 36.0847 7.70606 34.9139 8.87979L27.6108 16.1829C27.5791 16.2147 27.5499 16.2481 27.5232 16.2828C27.4891 16.3091 27.4563 16.3378 27.425 16.3691L24.0261 19.768L23.3883 19.1301C23.3784 19.1202 23.3684 19.1107 23.3583 19.1013L13.1527 8.89569C11.9828 7.72286 10.0803 7.72286 8.90954 8.89659C7.74007 10.0691 7.74007 11.9675 8.91044 13.1379L19.7833 24.0108L8.92904 34.8651C8.80498 34.9853 8.63403 35.1885 8.46649 35.4607C7.76939 36.5931 7.76653 37.9264 8.92154 39.0798C10.0972 40.2298 11.4174 40.2314 12.5531 39.5674C12.8256 39.408 13.0302 39.2449 13.1621 39.1163L21.9373 30.3413C22.3278 29.9508 22.3278 29.3176 21.9373 28.9271C21.5467 28.5366 20.9136 28.5366 20.523 28.9271L11.757 37.6931C11.7422 37.7074 11.6609 37.7722 11.5436 37.8408C11.1166 38.0905 10.7697 38.0901 10.351 37.6807C9.91539 37.2458 9.91609 36.921 10.1697 36.5091C10.2407 36.3938 10.3083 36.3134 10.3326 36.2898L24.0261 22.5964L25.4397 24.01L23.4948 25.9549C23.3637 26.086 23.2766 26.2445 23.2335 26.412C23.0117 26.7946 23.0645 27.2928 23.392 27.6203L34.908 39.1363C36.0806 40.3088 37.9797 40.3088 39.1523 39.1363C40.3226 37.9629 40.3226 36.0645 39.1523 34.8941L28.2682 24.01ZM26.8539 25.4242L25.4392 26.839L36.3223 37.7221C36.7137 38.1136 37.3466 38.1136 37.7371 37.723C38.1277 37.3315 38.1277 36.6979 37.738 36.3083L26.8539 25.4242ZM22.6113 21.1828L21.1975 22.5966L10.3247 11.7237C9.93503 11.3341 9.93503 10.7005 10.3256 10.309C10.7148 9.91873 11.3483 9.91873 11.7375 10.309L22.6113 21.1828Z"
                                  fill="#000" ></path>
                            </g>
                        </g>
                    </g>
                </svg>

            }
            else 
            {

                <button type="submit"  class="  py-2 px-8 text-white rounded-xl hover:text-black hover:bg-white hover:border border-black bg-black cursor-pointer ">Discard</button>
                <button type="submit" 
                    class=" ml-auto py-2 px-8  text-white rounded-xl  hover:text-black hover:bg-white hover:border border-black bg-black cursor-pointer "
                    @onclick="HandleSave"
                >Save</button>
               
            }
                    
        </div>

    </section>
    
    <section class=" flex flex-col  gap-7 px-2 overflow-y-scroll h-full w-full md:w-[38%] ">
        @foreach(Document? item in Documents)
        {
            <div 
                class="flex flex-col justify-center  w-full h-[30rem] border shadow-xl rounded-2xl px-4 md:px-6 py-8 bg-black text-white relative cursor-pointer"
                @onmouseover=" () => HandleDisplayMore(item.Id)"
                @onmouseleave="() => HandleHideMore(item.Id)"
            >

                <h1 class="flex justify-between items-center font-mono font-bold text-2xl md:text-lg lmd:text-2xl">@item.Title</h1>
                <p class="text-xs md:text-xs lmd:text-sm mt-1 mb-3 font-mono font-semibold pl-1">@item.Date</p>
                <p class="text-[1rem] md:text-sm lmd:text-[1rem] px-3 font-serif">@item.HalvedContent</p>

                <ul class="@GetActiveClass(item.IsHovered) absolute top-14 right-1 bg-white text-black w-fit p-2 list-disc list-inside font-mono font-medium rounded-2xl">
                    <li class="hover:bg-black hover:text-white rounded-xl px-4 py-1 cursor-pointer" @onclick="()=> ReadDocument(item.Id)">Read Document </li>
                    <li class="hover:bg-black hover:text-white rounded-xl px-4 py-1 cursor-pointer" @onclick="()=> EditDocument(item.Id)">Edit Document</li>
                    <li class="hover:bg-red-600 hover:text-white rounded-xl px-4 py-1 cursor-pointer">Delete Document</li>
                </ul>
                
            </div>
        }
        
    </section>

</main>


@code {

    private string ContentTitle { get; set; } = string.Empty!;
    private string ContentBody { get; set; } = string.Empty!;
    private bool IsReadOnly { get; set; } = false;
    private bool Feedback{ get; set; } = false;
    private string? FeedbackText{ get; set; } = null!;

    private bool DisplayMore { get; set;} = false;
    private Guid? ActiveItem {get; set;} = null;

    protected override void OnInitialized()
    {
        SharedData.OnChange += StateHasChanged;
    }

    private void HandleSave()
    {
        if ( ContentTitle.Length < 1 )
        {
            Feedback = !Feedback;
            FeedbackText = " Document title feild cannot be empty.";
            
        }
        else if ( ContentBody.Length < 1 )
        {
            Feedback = !Feedback;
            FeedbackText = "No Documentation was made.";
        }
        else 
        {
            @* Add ApI here *@
            Console.WriteLine("saved");
        }
        @* StateHasChanged(); *@
    }

    private void HandleDisplayMore(Guid id)
    {
        Document? item = Documents.FirstOrDefault(i => i.Id == id);
        if (item != null)
        {
           item.IsHovered = true;
        }
        else 
        {
            Console.WriteLine($"{item} not found");
        }
        
    }

    private void HandleHideMore(Guid id)
    {

        Document? item = Documents.FirstOrDefault(i => i.Id == id);
        if (item != null)
        {
           item.IsHovered = false;
        }
         else 
        {
            Console.WriteLine($"{item} not found");
        }
        
    }

    private void ReadDocument(Guid id)
    {
        StateHasChanged();
        Document? item = Documents.FirstOrDefault(i => i.Id == id);
        if(item != null)
        {
            ContentTitle = item.Title;
            ContentBody = item.Content;
            IsReadOnly = true;

            StateHasChanged();
        }
        else
        {
            Console.WriteLine($"{item} not found");
        }
    }

    private void EditDocument(Guid id)
    {
        StateHasChanged();
        Document? item = Documents.FirstOrDefault(i => i.Id == id);
        if(item != null)
        {
            ContentTitle = item.Title;
            ContentBody = item.Content;

            StateHasChanged();
        }
        else
        {
            Console.WriteLine($"{item} not found");
        }
    }


    private string GetActiveClass(bool isHovered)
    {
        return isHovered ? "visible" : "hidden";
    }


    public void Dispose()
    {
        SharedData.OnChange -= StateHasChanged;
    }

    public class Document 
    {
        public Guid Id {get; set;}
        public string Title { get; set;} = string.Empty;
        public string Date { get; set;} = string.Empty;
        public string Content { get; set;} = string.Empty;
        public bool IsHovered { get; set; } = false;
        public string HalvedContent { 
            get
            {
               int MaxLength = 200;
                if (Content.Length > MaxLength)
                {
                    return Content.Substring(0, MaxLength) + "...";
                } 
                return Content;
            }
        }
        
    }

